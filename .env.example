[TEMPLATE]
# ─── EnglishPath Environment Variables ─────────────────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
#
# ┌─────────────────────────────────────────────────────────────────────────┐
# │ 📌 MUHIM: VITE_ prefiksli o'zgaruvchilar CLIENT-side (brauzer) ga      │
# │    boradi. VITE_ prefiksizlari esa SERVER-side (Vercel serverless,     │
# │    seed scriptlar) da ishlatiladi.                                     │
# │                                                                         │
# │ Vercel dashboard'da IKKALA guruhni ham belgilash kerak:               │
# │   • VITE_SUPABASE_URL, VITE_SUPABASE_ANON_KEY, VITE_CLAUDE_MODEL      │
# │   • ANTHROPIC_API_KEY, SUPABASE_SERVICE_KEY                           │
# └─────────────────────────────────────────────────────────────────────────┘

# ─── Anthropic Claude (SERVER-side — Vercel serverless uchun) ──────────────
# Vercel dashboard'da: ANTHROPIC_API_KEY = sk-ant-...
# Local development: .env da ANTHROPIC_API_KEY = sk-ant-...
# Get yours at: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional: override default Claude model
# Vercel dashboard'da: CLAUDE_MODEL = claude-sonnet-4-5
# (Localda VITE_CLAUDE_MODEL ham ishlaydi)
# CLAUDE_MODEL=claude-sonnet-4-5

# ─── Supabase (CLIENT-side - VITE_ prefiks kerak) ─────────────────────────
# Vercel dashboard'da: VITE_SUPABASE_URL va VITE_SUPABASE_ANON_KEY
# Bu o'zgaruvchilar Vite build vaqtida client code'ga embed qilinadi
# https://supabase.com/dashboard/project/_/settings/api
VITE_SUPABASE_URL=https://julclavaqxzffslmaard.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_LmHiGYXbs0fd_2ilSxSNng_QwzpYdnA

# ─── Supabase Service Key (SERVER-side - seed scriptlar uchun) ─────────────
# NEVER put sb_secret key in VITE_ variables - bu server-side maxfiy kalit
SUPABASE_SERVICE_KEY=sbp_v0_b1d9c3cf3bde25699f684d6c0ed5504c5a34c5eb

# ─── Optional: override Claude model (client-side override) ───────────────
# VITE_CLAUDE_MODEL=claude-sonnet-4-5

# ─── Sentry Error Tracking (optional) ────────────────────────────────────
# https://sentry.io/settings/account/api/
# Sourcemap yuklash (deploy'dan keyin):
#   npx sentry-cli sourcemaps inject ./dist
#   npx sentry-cli sourcemaps upload --release=englishpath@<version> ./dist
# VITE_SENTRY_DSN=https://xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx@xxxxxx.ingest.us.sentry.io/xxxxxx
