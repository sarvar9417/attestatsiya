# ─── Supabase ─────────────────────────────────────────────────────────────
VITE_SUPABASE_URL=your_supabase_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# ─── Backend API (Fastify) ────────────────────────────────────────────────
# Lokal: http://localhost:3001
# Prod (Vercel): backend loyihasining URL manzili, masalan
# https://attestatsiya-backend.vercel.app
# Agar backend ishlamayotgan bo'lsa, imtihon va progress avtomatik
# Supabase RPC fallback'ga o'tadi.
VITE_API_BASE_URL=http://localhost:3001

