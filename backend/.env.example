# ─── Supabase ──────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=sb_service_role_key_here

# ─── Server ─────────────────────────────────────────────────────
PORT=3001
HOST=0.0.0.0
NODE_ENV=development

# ─── Rate Limiting ──────────────────────────────────────────────
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# ─── Demo Mode (login-free access) ─────────────────────────────
# Set DEMO_MODE=true to bypass authentication for testing/demo
# DEMO_MODE=true
# DEMO_USER_EMAIL=demo@attestatsiya.uz
# DEMO_USER_PASSWORD=demo123456

# ─── Auth ────────────────────────────────────────────────────────
# Parolni tiklash xatidagi redirect manzil (frontend root URL)
# Prod (Vercel): https://attestatsiya-five.vercel.app
AUTH_REDIRECT_URL=http://localhost:3000

# ─── Vercel (serverless) ────────────────────────────────────────────
# Backend'ni Vercel'da deploy qilish uchun api/[...all].ts ishlatiladi.
# Vercel project env vars (backend loyihasi):
#   SUPABASE_URL           -> supabase_url
#   SUPABASE_SERVICE_KEY   -> supabase_service_key
#   AUTH_REDIRECT_URL      -> auth_redirect_url
# Frontend loyihasi env vars:
#   VITE_API_BASE_URL      -> vite_api_base_url (backend URL)
