{
  "name": "englishpath",
  "version": "1.0.0",
  "description": "A2+ dan B2 darajasiga 90 kunda yetish uchun intensiv ingliz tili o'quv platformasi",
  "type": "module",
  "engines": {
    "node": "20.x"
  },
  "browserslist": {
    "production": [
      ">0.3%",
      "last 2 versions",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "scripts": {
    "dev": "vite",
    "prebuild": "npm run validate:ids && UPDATE_INDEX=1 vitest run src/data/__tests__/lessonsIndex.test.ts 2>&1 | tail -1",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint src --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "check:murojaat": "tsx scripts/check-murojaat.ts",
    "check:youtube": "tsx scripts/check-youtube-availability.ts",
    "audit:cefr": "tsx scripts/cefr-audit.ts",
    "audit:exercises": "tsx scripts/audit-exercises.ts",
    "check:i18n": "tsx scripts/check-i18n.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "seed": "npm run seed:vocab",
    "seed:vocab": "tsx scripts/seed-vocabulary.ts",
    "seed:phrases": "tsx scripts/seed-phrases.ts",
    "seed:words": "tsx scripts/seed-words-table.ts",
    "seed:tenses": "tsx scripts/insert-tenses-seed.mjs",
    "seed:reviews": "tsx scripts/seed-review-lessons.ts",
    "seed:all": "tsx scripts/seed-lessons-sql.ts",
    "seed:supabase": "tsx scripts/seed-supabase.ts",
    "seed:sql": "tsx scripts/generate-seed-sql.ts",
    "gen-types": "python3 scripts/gen_supabase_types.py",
    "fix-lessons": "tsx scripts/fix-lessons.ts",
    "fix-lessons:dry": "tsx scripts/fix-lessons.ts --dry-run",
    "audit:ambiguous": "tsx scripts/find-ambiguous-exercises.ts",
    "validate:ids": "tsx scripts/validate-lesson-ids.ts",
    "validate:speaking": "tsx scripts/validate-speaking-grammar-map.ts",
    "fix:ids": "tsx scripts/fix-exercise-ids.ts",
    "test:e2e": "playwright test --config e2e/playwright.config.ts",
    "test:e2e:ui": "playwright test --ui --config e2e/playwright.config.ts"
  },
  "dependencies": {
    "@sentry/react": "10.53.1",
    "@supabase/supabase-js": "2.105.4",
    "dexie": "3.2.7",
    "lucide-react": "0.447.0",
    "pg": "^8.22.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.30.4",
    "recharts": "2.13.0",
    "vite-plugin-pwa": "^1.3.0",
    "zod": "^4.4.3",
    "zustand": "5.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "^20.19.0",
    "@types/react": "18.3.11",
    "@types/react-dom": "18.3.1",
    "@typescript-eslint/eslint-plugin": "8.59.4",
    "@typescript-eslint/parser": "8.59.4",
    "@vitejs/plugin-react": "^4.4.1",
    "@vitest/coverage-v8": "^3.1.2",
    "autoprefixer": "10.4.20",
    "axe-core": "4.12.0",
    "dotenv": "16.3.1",
    "eslint": "8.57.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "jsdom": "24.1.3",
    "postcss": "^8.5.15",
    "tailwindcss": "3.4.13",
    "tsx": "^4.22.4",
    "typescript": "5.6.2",
    "vite": "^6.3.2",
    "vite-plugin-compression": "0.5.1",
    "vitest": "^3.1.2",
    "vitest-axe": "0.1.0"
  }
}
